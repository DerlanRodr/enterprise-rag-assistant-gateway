# ==============================================================================
# CONFIGURAÇÃO DE AMBIENTE - ENTERPRISE RAG ASSISTANT GATEWAY
# ==============================================================================

# Aplicação
APP_NAME="Enterprise RAG Assistant Gateway"
APP_ENV="development"
APP_HOST="0.0.0.0"
APP_PORT=8000
DEBUG=false

# Banco Vetorial SurrealDB v2
SURREAL_URL="ws://localhost:8000/rpc"
SURREAL_USER="root"
SURREAL_PASS="root"
SURREAL_NS="enterprise"
SURREAL_DB="knowledge_base"

# Open Notebook Integration
OPEN_NOTEBOOK_API_URL="http://localhost:5055/api"
OPEN_NOTEBOOK_NOTEBOOK_ID="notebook:enterprise_knowledge_demo"

# Segurança e Controle de Acesso (Whitelist de Contatos Autorizados)
# Formato: Lista de identificadores/telefones autorizados separados por vírgula
AUTHORIZED_CONTACTS="+5511999990001,+5511999990002,+5585999990003"
SECURITY_TOKEN="demo-secret-token-change-in-production"

# RAG & Anti-Alucinação
SIMILARITY_THRESHOLD=0.20
MAX_CHUNKS_PER_QUERY=3
STRICT_GROUND_TRUTH=true
